@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()

title C4 Container — приоритизация операций финмониторинга

Person(analyst, "Сотрудник финмониторинга", "Разбирает операции и фиксирует исход")
System_Ext(kyc, "Знай своего клиента", "Внешний вспомогательный сигнал риска")
System_Ext(dependencies, "Внешние источники зависимостей", "Пакеты, базовые образы и модельные артефакты")

Boundary(bank, "Контур банка", "Пунктирная граница обработки чувствительных данных") {
  Container(payments, "Платёжные системы и правила", "Существующие системы", "Помечают операции и сохраняют обязательные сигналы")
  Container(ingestion, "Приём и валидация", "Обычный код", "Контракт входа, дедупликация, карантин ошибочных событий")
  ContainerDb(features, "Хранилище признаков", "Версионированные снимки", "Только данные с cutoff до момента скоринга")
  Container(scoring, "Сервис скоринга", "ML + обычный код", "Score приоритетности, объяснение и воздержание")
  Container(policy, "Политика очереди", "Детерминированные правила", "Обязательные приоритеты, ограничения и маршрутизация")
  Container(queue, "Оркестратор очереди", "Обычный код", "Идемпотентное обновление порядка без удаления операций")
  Container(cases, "Case Management", "Существующая система", "Очередь, карточка операции, решение сотрудника")
  Container(labeling, "Разметка и контрольная выборка", "Обычный код + эксперты", "Гайдлайн, двойная разметка, вероятностный контроль")
  Container(training, "Обучение и оценка", "Офлайн-конвейер", "Временные разбиения, регрессионные наборы, отбор модели")
  ContainerDb(registry, "Реестр моделей и артефактов", "Контролируемое хранилище", "Проверенные версии, подписи и происхождение")
  Container(monitoring, "Наблюдаемость и аудит", "Метрики без сырого содержимого", "Вход, модель, очередь, бизнес-guardrails")
}

Rel(kyc, ingestion, "[TB1] Внешний сигнал", "Только разрешённый контракт")
Rel(payments, ingestion, "[TB2] Помеченная операция", "Событие и версия правил")
Rel(ingestion, features, "Нормализованные признаки")
Rel(features, scoring, "Снимок признаков")
Rel(scoring, policy, "Score, reason codes, fallback")
Rel(policy, queue, "Разрешённый порядок")
Rel(queue, cases, "Приоритетная очередь")
Rel(analyst, cases, "Разбор и решение")
Rel(cases, labeling, "Исходы разбора")
Rel(labeling, training, "Метки и согласованность")
Rel(features, training, "Обучающие снимки")
Rel(training, registry, "Проверенная модель")
Rel(dependencies, registry, "[TB4] Проверка и подписание")
Rel(registry, scoring, "Закреплённая версия модели")
Rel(scoring, monitoring, "[TB5] Технические метрики")
Rel(queue, monitoring, "Возраст и состав очереди")
Rel(cases, monitoring, "Время, приостановки, жалобы")

@enduml
